# Git LFS for large visual assets. Patterns name their folder so no rule can
# be read as covering the plugin folders (Claude plugin directory check).
gifs/*.gif filter=lfs diff=lfs merge=lfs -text
videos/*.mp4 filter=lfs diff=lfs merge=lfs -text
/contact-sheet.png filter=lfs diff=lfs merge=lfs -text
screenshots/**/*-annotated.png filter=lfs diff=lfs merge=lfs -text
